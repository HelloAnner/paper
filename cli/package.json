{
  "name": "paper",
  "version": "0.1.0",
  "description": "paper —— 生成本地离线专业文档的 CLI（docx / pdf / html）",
  "type": "module",
  "private": true,
  "bin": {
    "paper": "./dist/paper"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "registry": "bun run scripts/gen-registry.ts",
    "build": "bun run scripts/build.ts",
    "fonts": "bun run scripts/fetch-fonts.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "docx": "^9.7.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
